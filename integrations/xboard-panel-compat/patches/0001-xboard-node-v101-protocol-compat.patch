diff --git a/app/Support/XboardNodeV101Compatibility.php b/app/Support/XboardNodeV101Compatibility.php
new file mode 100644
--- /dev/null
+++ b/app/Support/XboardNodeV101Compatibility.php
@@ -0,0 +1,61 @@
+<?php
+
+namespace App\Support;
+
+use InvalidArgumentException;
+
+/**
+ * Wire-level guardrails shared by Xboard-Node V1.0.1 integrations.
+ *
+ * This helper deliberately does not silently turn an unsupported protocol
+ * into HTTP, SOCKS, or a generic multiplex entry.
+ */
+final class XboardNodeV101Compatibility
+{
+    public static function normalizeNodeConfig(array $config): array
+    {
+        if (isset($config['cert_config']) && is_array($config['cert_config'])) {
+            $cert = $config['cert_config'];
+            if (isset($cert['mode']) && !isset($cert['cert_mode'])) {
+                $cert['cert_mode'] = $cert['mode'];
+            }
+            unset($cert['mode']);
+            $config['cert_config'] = $cert;
+        }
+
+        if (isset($config['padding_scheme']) && is_string($config['padding_scheme'])) {
+            $config['padding_scheme'] = [$config['padding_scheme']];
+        }
+        if (isset($config['transport'])) {
+            $config['transport'] = strtoupper((string) $config['transport']);
+        }
+        if (isset($config['traffic_pattern'])) {
+            $config['traffic_pattern'] = (string) $config['traffic_pattern'];
+        }
+
+        return $config;
+    }
+
+    public static function credential(array $user): string
+    {
+        $uuid = trim((string) ($user['uuid'] ?? ''));
+        if ($uuid === '') {
+            throw new InvalidArgumentException('Xboard-Node V1.0.1 requires a non-empty user uuid');
+        }
+        return $uuid;
+    }
+
+    public static function assertSupported(string $client, array $servers, array $supported): void
+    {
+        $unsupported = [];
+        foreach ($servers as $server) {
+            $type = (string) ($server['type'] ?? '');
+            if ($type !== '' && !in_array($type, $supported, true)) {
+                $unsupported[$type] = true;
+            }
+        }
+        if ($unsupported !== []) {
+            throw new XboardNodeV101UnsupportedProtocolException($client, array_keys($unsupported));
+        }
+    }
+}
diff --git a/app/Support/XboardNodeV101UnsupportedProtocolException.php b/app/Support/XboardNodeV101UnsupportedProtocolException.php
new file mode 100644
--- /dev/null
+++ b/app/Support/XboardNodeV101UnsupportedProtocolException.php
@@ -0,0 +1,19 @@
+<?php
+
+namespace App\Support;
+
+use InvalidArgumentException;
+
+final class XboardNodeV101UnsupportedProtocolException extends InvalidArgumentException
+{
+    public function __construct(
+        public readonly string $client,
+        public readonly array $protocols,
+    ) {
+        parent::__construct(sprintf(
+            'subscription client %s does not support protocol(s): %s',
+            $client,
+            implode(', ', $protocols),
+        ));
+    }
+}
diff --git a/tests/Unit/Support/XboardNodeV101CompatibilityTest.php b/tests/Unit/Support/XboardNodeV101CompatibilityTest.php
new file mode 100644
--- /dev/null
+++ b/tests/Unit/Support/XboardNodeV101CompatibilityTest.php
@@ -0,0 +1,86 @@
+<?php
+
+namespace Tests\Unit\Support;
+
+use App\Models\Server;
+use App\Services\ServerService;
+use App\Support\XboardNodeV101Compatibility;
+use App\Support\XboardNodeV101UnsupportedProtocolException;
+use PHPUnit\Framework\TestCase;
+
+class XboardNodeV101CompatibilityTest extends TestCase
+{
+    public function test_node_snapshot_preserves_protocol_specific_fields(): void
+    {
+        $config = XboardNodeV101Compatibility::normalizeNodeConfig([
+            'protocol' => Server::TYPE_ANYTLS,
+            'server_port' => 443,
+            'tls_settings' => ['server_name' => 'node.example.test'],
+            'padding_scheme' => 'randomized-v1',
+            'cert_config' => ['mode' => 'acme'],
+            'transport' => 'tcp',
+            'traffic_pattern' => 'standard',
+        ]);
+
+        self::assertSame([
+            'protocol' => Server::TYPE_ANYTLS,
+            'server_port' => 443,
+            'tls_settings' => ['server_name' => 'node.example.test'],
+            'padding_scheme' => ['randomized-v1'],
+            'cert_config' => ['cert_mode' => 'acme'],
+            'transport' => 'TCP',
+            'traffic_pattern' => 'standard',
+        ], $config);
+    }
+
+    public function test_server_service_uses_the_same_wire_shape_for_mieru(): void
+    {
+        $server = new Server();
+        $server->type = Server::TYPE_MIERU;
+        $server->host = 'node.example.test';
+        $server->server_port = 8443;
+        $server->protocol_settings = [
+            'transport' => 'udp',
+            'traffic_pattern' => 'standard',
+        ];
+
+        self::assertSame([
+            'protocol' => Server::TYPE_MIERU,
+            'listen_ip' => '0.0.0.0',
+            'server_port' => 8443,
+            'network' => null,
+            'networkSettings' => null,
+            'transport' => 'UDP',
+            'traffic_pattern' => 'standard',
+        ], ServerService::buildNodeConfig($server));
+    }
+
+    public function test_user_uuid_is_required_for_subscription_credentials(): void
+    {
+        self::assertSame('user-uuid', XboardNodeV101Compatibility::credential([
+            'uuid' => ' user-uuid ',
+        ]));
+
+        $this->expectException(\InvalidArgumentException::class);
+        XboardNodeV101Compatibility::credential(['uuid' => '']);
+    }
+
+    public function test_unsupported_protocols_are_reported_instead_of_dropped(): void
+    {
+        try {
+            XboardNodeV101Compatibility::assertSupported(
+                'clash',
+                [
+                    ['type' => Server::TYPE_HTTP],
+                    ['type' => Server::TYPE_NAIVE],
+                    ['type' => Server::TYPE_NAIVE],
+                ],
+                [Server::TYPE_HTTP],
+            );
+            self::fail('Expected an unsupported protocol exception');
+        } catch (XboardNodeV101UnsupportedProtocolException $exception) {
+            self::assertSame('clash', $exception->client);
+            self::assertSame([Server::TYPE_NAIVE], $exception->protocols);
+        }
+    }
+}
