+            return $protocolInstance->handle();
+        } catch (XboardNodeV101UnsupportedProtocolException $exception) {
+            return response()->json([
+                'message' => $exception->getMessage(),
+                'client' => $exception->client,
+                'unsupported_protocols' => $exception->protocols,
